{
  "name": "cloudflare-imgbed",
  "version": "2.6.3",
  "type": "module",
  "scripts": {
    "ci-test": "concurrently --kill-others \"npm start\" \"wait-on http://localhost:8788 && npm test\"",
    "test": "npm run verify:worker-routes && mocha",
    "start": "npm run worker:dev",
    "patch:admin-session": "node scripts/patch-admin-session.mjs",
    "patch:music-admin-password": "node scripts/patch-music-admin-password.mjs",
    "patch:tg-upload-performance": "node scripts/patch-tg-upload-performance.mjs",
    "generate:worker-routes": "node deploy/worker/generate-routes.js",
    "verify:worker-routes": "node deploy/worker/generate-routes.js --check",
    "check": "npm test",
    "build:worker": "npm run generate:worker-routes && wrangler deploy --dry-run --outdir .wrangler-worker-build",
    "worker:dev": "npm run generate:worker-routes && wrangler dev --port 8788 --persist-to ./data",
    "worker:deploy": "npm run generate:worker-routes && wrangler deploy",
    "worker:deploy:dev": "npm run generate:worker-routes && wrangler deploy --env dev",
    "worker:secret": "wrangler secret put"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@cloudflare/pages-plugin-sentry": "^1.1.3",
    "@sentry/tracing": "^7.114.0",
    "miniflare": "^3.20240718.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.6"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "mocha": "^10.6.0",
    "wait-on": "^7.2.0",
    "wrangler": "^4.45.0"
  }
}
