{
  "name": "cloudflare-imgbed",
  "version": "2.6.3",
  "type": "module",
  "scripts": {
    "ci-test": "concurrently --kill-others \"npm start\" \"wait-on http://localhost:8080 && mocha\"",
    "test": "mocha",
    "start": "npm run pages:dev",
    "pages:dev": "npx wrangler pages dev ./ --kv \"img_url\" --r2 \"img_r2\" --ip 0.0.0.0 --port 8080 --persist-to ./data",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler-worker-build",
    "worker:dev": "wrangler dev --port 8788 --persist-to ./data",
    "worker:deploy": "wrangler deploy",
    "worker:deploy:dev": "wrangler deploy --env dev",
    "worker:secret": "wrangler secret put"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@cloudflare/pages-plugin-sentry": "^1.1.3",
    "@sentry/tracing": "^7.114.0",
    "miniflare": "^3.20240718.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.6"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "mocha": "^10.6.0",
    "wait-on": "^7.2.0",
    "wrangler": "^4.45.0"
  }
}
