# Cloudflare Workers 静态资源排除列表
# assets.directory = "." 时生效，排除以下文件/目录不上传为静态资源
# 文档：https://developers.cloudflare.com/workers/static-assets/configuration/#assetsignore

# Worker 源码
src/
_worker.js

# Functions 源码（Workers 模式下由 src/worker.js 直接 import）
functions/

# 依赖与构建产物
node_modules/
.wrangler/
.wrangler-worker-build/
.wrangler-assets/

# 开发数据
data/

# 配置文件
wrangler.toml
package.json
package-lock.json
.assetsignore
.gitignore
.dockerignore

# Docker
Dockerfile
docker-compose.yml

# 文档
README.md
README_en.md
LICENSE

# Git
.git/
.github/

# IDE
.kiro/
.vscode/

# 压缩文件（已有 index.html，无需上传 .gz）
*.gz
