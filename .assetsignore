# Cloudflare Workers 静态资源排除列表
# assets.directory = "." 时生效，排除以下文件/目录不上传为静态资源
# 文档：https://developers.cloudflare.com/workers/static-assets/configuration/#assetsignore

# Worker 源码
src/
_worker.js

# Functions 源码（Workers 模式下由 src/worker.js 直接 import）
functions/

# 依赖与构建产物
node_modules/
.wrangler/
.wrangler-worker-build/
.wrangler-assets/
.wrangler-config/

# 开发数据
data/

# 配置文件
wrangler.toml
package.json
package-lock.json
.assetsignore
.gitignore
.dockerignore

# Docker
Dockerfile
docker-compose.yml

# 文档
README.md
README_en.md
LICENSE

# Git
.git/
.github/
.agents/
.codex/
.worktrees/

# IDE / 工具
.kiro/
.vscode/
.claude/

# 开发目录（测试、文档）禁止部署为站点资源
test/
docs/

# 压缩文件（Cloudflare 自动压缩，无需上传预压缩的 .gz）
*.gz
**/*.gz

# Source maps（仅调试用，禁止上线，体积可达数 MB）
*.map
**/*.map

# README/文档用截图（仅 README 引用，约 43MB，禁止作为站点资源上传）
static/readme/

# 未被任何页面引用的历史截图
screenshot-home.png
